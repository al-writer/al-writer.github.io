---
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
}

const siteName = 'Сказки из латентного пространства';
const {
  title,
  description = 'Короткие рассказы, которые пишет искусственный интеллект. Публикуются без правок.',
  type = 'website',
  publishedTime,
} = Astro.props;
const fullTitle = title ? `${title} — ${siteName}` : siteName;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#faf7f0" />
    <meta name="color-scheme" content="light dark" />

    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="ru_RU" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary" />

    <script is:inline>
      try {
        var t = localStorage.getItem('theme');
        if (t) document.documentElement.dataset.theme = t;
        var s = localStorage.getItem('font-scale');
        if (s) document.documentElement.style.setProperty('--font-scale', s);
      } catch (e) {}
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">К содержимому</a>
    <header class="site-header">
      <a class="brand" href="/">Сказки из&nbsp;латентного пространства</a>
      <nav aria-label="Основная">
        <a href="/">Рассказы</a>
        <a href="/genres/">Жанры</a>
        <a href="/tags/">Теги</a>
        <a href="/search/">Поиск</a>
        <a href="/about/">О проекте</a>
        <a href="/rss.xml" aria-label="RSS">RSS</a>
        <ThemeToggle />
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>© {new Date().getFullYear()} Al Writer. Рассказы написаны ИИ и публикуются без правок. <a href="/about/">О проекте</a></p>
    </footer>

    <script is:inline>
      if ('serviceWorker' in navigator && location.protocol === 'https:') {
        navigator.serviceWorker.register('/sw.js').catch(function () {});
      }
    </script>
  </body>
</html>
