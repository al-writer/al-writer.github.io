---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import {
  formatDate,
  formatDateTime,
  getStories,
  readingMinutes,
  slugify,
  textStats,
} from '../../../lib/stories';

export async function getStaticPaths() {
  const stories = await getStories();
  return stories.map((story, i) => ({
    params: { slug: story.id },
    props: { story, newer: stories[i - 1], older: stories[i + 1] },
  }));
}

const { story, newer, older } = Astro.props;
const { title, description, genre, tags, pubDate, written } = story.data;
const { Content } = await render(story);
const stats = textStats(story.body);
const num = new Intl.NumberFormat('ru-RU');
const statRows = [
  ['Абзацев', stats.paragraphs],
  ['Предложений', stats.sentences],
  ['Слов', stats.words],
  ['Символов', stats.chars],
  ['С пробелами', stats.charsWithSpaces],
] as const;
---

<Base title={title} description={description} type="article" publishedTime={pubDate}>
  <button type="button" class="read-bar" id="read-bar" tabindex="-1" data-pagefind-ignore>
    <span class="read-bar-fill" id="read-fill" aria-hidden="true"></span>
    <span class="read-bar-title">{title}</span>
    <span class="read-bar-pct" id="read-pct" aria-hidden="true">0%</span>
    <span class="visually-hidden">— наверх</span>
  </button>

  <article data-pagefind-body data-story={story.id}>
    <header class="story-header">
      <p class="meta">
        <a href={`/genres/${slugify(genre)}/`}>{genre}</a>
        <span aria-hidden="true">·</span>
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingMinutes(story.body)} мин чтения</span>
      </p>
      <h1 id="story-title" data-pagefind-meta="title">{title}</h1>
      <div class="reader-tools" role="group" aria-label="Настройки чтения" data-pagefind-ignore>
        <button type="button" id="font-down" aria-label="Уменьшить шрифт">A−</button>
        <button type="button" id="font-up" aria-label="Увеличить шрифт">A+</button>
      </div>
    </header>

    <p class="resume" id="resume" data-pagefind-ignore>
      Вы остановились на абзаце <span id="resume-at"></span>.
      <button type="button" id="resume-go">Продолжить</button>
    </p>

    <div class="prose">
      <Content />
    </div>

    <footer class="story-stats" aria-label="Статистика текста" data-pagefind-ignore>
      <dl>
        {
          statRows.map(([label, value]) => (
            <div>
              <dt>{label}</dt>
              <dd>{num.format(value)}</dd>
            </div>
          ))
        }
      </dl>
      {
        written && (
          <p>
            Написан <time datetime={written.toISOString()}>{formatDateTime(written)}</time>
          </p>
        )
      }
    </footer>

  </article>

  <ul class="chips" style="margin-top: 2rem" aria-label="Теги" data-pagefind-ignore>
    {
      tags.map((t) => (
        <li>
          <a class="chip" href={`/tags/${slugify(t)}/`}>
            #{t}
          </a>
        </li>
      ))
    }
  </ul>

  <nav class="story-nav" aria-label="Другие рассказы" data-pagefind-ignore>
    {
      older && (
        <a class="prev" href={`/stories/${older.id}/`} rel="prev">
          <small>← Раньше</small>
          {older.data.title}
        </a>
      )
    }
    {
      newer && (
        <a class="next" href={`/stories/${newer.id}/`} rel="next">
          <small>Позже →</small>
          {newer.data.title}
        </a>
      )
    }
  </nav>

  <script>
    const root = document.documentElement;
    const store = {
      get: (k: string) => {
        try {
          return localStorage.getItem(k);
        } catch {
          return null;
        }
      },
      set: (k: string, v: string) => {
        try {
          localStorage.setItem(k, v);
        } catch {}
      },
    };

    // Font size
    let scale = parseFloat(store.get('font-scale') ?? '1') || 1;
    const applyScale = (s: number) => {
      scale = Math.min(1.6, Math.max(0.8, Math.round(s * 100) / 100));
      root.style.setProperty('--font-scale', String(scale));
      store.set('font-scale', String(scale));
    };
    document.getElementById('font-up')?.addEventListener('click', () => applyScale(scale + 0.1));
    document.getElementById('font-down')?.addEventListener('click', () => applyScale(scale - 0.1));

    // Reading progress + remembered paragraph
    const bar = document.getElementById('read-bar')!;
    const fill = document.getElementById('read-fill')!;
    const pct = document.getElementById('read-pct')!;
    const id = document.querySelector<HTMLElement>('[data-story]')!.dataset.story!;
    const key = `para:${id}`;
    const paras = [...document.querySelectorAll<HTMLElement>('.prose > p')];
    try {
      localStorage.removeItem(`pos:${id}`); // old scroll-ratio format
    } catch {}

    // The paragraph being read: the last one whose top has passed the upper third of the screen.
    const currentPara = () => {
      const line = innerHeight / 3;
      let current = 0;
      for (const [i, p] of paras.entries()) {
        if (p.getBoundingClientRect().top > line) break;
        current = i;
      }
      return current;
    };

    let ticking = false;
    const progress = () => {
      const max = document.documentElement.scrollHeight - innerHeight;
      const ratio = max > 0 ? Math.min(1, scrollY / max) : 0;
      fill.style.transform = `scaleX(${ratio})`;
      pct.textContent = `${Math.round(ratio * 100)}%`;
      if (ratio >= 0.98) store.set(key, '0');
      else if (ratio > 0.02) store.set(key, String(currentPara()));
      ticking = false;
    };
    addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(progress);
        }
      },
      { passive: true },
    );

    const saved = parseInt(store.get(key) ?? '0', 10);
    const target = paras[saved];
    if (saved > 0 && target) {
      const box = document.getElementById('resume')!;
      document.getElementById('resume-at')!.textContent = `${saved + 1} из ${paras.length}`;
      box.classList.add('show');
      document.getElementById('resume-go')!.addEventListener('click', () => {
        box.classList.remove('show');
        target.scrollIntoView({ block: 'start' });
        target.classList.add('resume-mark');
        target.addEventListener('animationend', () => target.classList.remove('resume-mark'), {
          once: true,
        });
      });
    }
    progress();

    // The title bar slides in once the big heading has scrolled out of view.
    new IntersectionObserver(([entry]) => {
      const show = !entry.isIntersecting && entry.boundingClientRect.top < 0;
      bar.classList.toggle('show', show);
      bar.tabIndex = show ? 0 : -1;
    }).observe(document.getElementById('story-title')!);
    bar.addEventListener('click', () => scrollTo({ top: 0 }));
  </script>
</Base>
